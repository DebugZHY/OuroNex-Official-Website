# OuroNex environment template - PLACEHOLDERS ONLY.
#
# Copy this file to the shared configuration directory as `.env`
# (example: D:\OuroNex\shared\config\.env), then replace every <...> placeholder.
# The real .env lives outside the repository and outside every release directory:
# it must never be shipped, committed, copied into releases\<name>\ or pasted into
# a ticket. Keep a copy in the password manager, not in the repository.
#
# Format: one KEY=VALUE per line, UTF-8 without BOM, no `export`, no quotes,
# no inline comments after a value. Lines starting with # are ignored.
# The launcher (deploy\windows\Start-OuroNex.ps1) reads this file, validates it,
# and only then starts Waitress. Missing or unsafe production values stop startup.
#
# Windows Server 2022 deployment runbook: docs\WINDOWS_SERVER_DEPLOYMENT.md

# development | production. Anything else is rejected. Use `production` on the server.
OURONEX_ENV=production

# REQUIRED in production: at least 50 characters. Generate a fresh value on the
# server and keep it out of source control, for example:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Never reuse the development key and never commit the result.
OURONEX_SECRET_KEY=<paste-50-or-more-random-characters-here>

# REQUIRED in production: comma-separated hostnames/IPs this instance answers for.
# No wildcard. Use the internal hostname now, add the public hostname when the
# public DNS record exists. 127.0.0.1 is required for the local health check.
OURONEX_ALLOWED_HOSTS=<internal-hostname>,127.0.0.1

# REQUIRED in production: comma-separated HTTPS origins for CSRF protection.
# Scheme + host (+ port if non-default), no path, no trailing slash, no wildcard.
# Add the public origin only after HTTPS is proven on the public hostname.
OURONEX_CSRF_TRUSTED_ORIGINS=https://<internal-hostname>

# REQUIRED in production: absolute path to the SQLite file, outside the repository
# and outside the release tree, for example D:\OuroNex\shared\data\ouronex.sqlite3.
# The directory must already exist; the file is created by `manage.py migrate`.
OURONEX_DB_PATH=<absolute-path-outside-releases>\ouronex.sqlite3

# Optional tuning. The values below are the documented defaults.
# SQLite busy timeout in seconds for the application connection.
OURONEX_SQLITE_TIMEOUT_SECONDS=30
# Bearer token lifetime in seconds (30 days).
OURONEX_AUTH_TOKEN_TTL_SECONDS=2592000
# HSTS is off until HTTPS has been proven through IIS. Set only after that.
OURONEX_SECURE_HSTS_SECONDS=0
# Only these peers may supply X-Forwarded-For. The list decides which client IP the
# application believes, so it only affects authentication throttling and audit
# logging. It does not decide whether X-Forwarded-Proto is trusted: loopback binding
# is what keeps that header trustworthy, because only the local IIS/ARR process can
# reach Waitress on 127.0.0.1. Never bind Waitress to a public address.
OURONEX_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Failed login/registration throttle: attempts per window, window length in seconds.
OURONEX_AUTH_MAX_ATTEMPTS=10
OURONEX_AUTH_WINDOW_SECONDS=300