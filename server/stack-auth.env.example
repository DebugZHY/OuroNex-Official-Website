# Stack Auth self-hosted environment template.
# Copy to stack-auth.env and fill in real values. Never commit stack-auth.env.

NEXT_PUBLIC_STACK_API_URL=http://localhost:8102
NEXT_PUBLIC_STACK_DASHBOARD_URL=http://localhost:8101
STACK_ENVIRONMENT=production

# PostgreSQL connection (same database as the app)
STACK_DATABASE_CONNECTION_STRING=postgres://postgres:changeme@ouronex-postgres:5432/ouronex

# Stack Auth server secret (generate a random 64-char hex string)
STACK_SERVER_SECRET=your-server-secret-64-hex-chars
CRON_SECRET=your-cron-secret

# ClickHouse (Stack Auth dependency)
STACK_CLICKHOUSE_URL=http://ouronex-clickhouse:8123
STACK_CLICKHOUSE_DATABASE=default
STACK_CLICKHOUSE_ADMIN_USER=default
STACK_CLICKHOUSE_ADMIN_PASSWORD=changeme
STACK_CLICKHOUSE_EXTERNAL_PASSWORD=changeme

# Seed internal project (only used on first run)
STACK_SEED_INTERNAL_PROJECT_PUBLISHABLE_CLIENT_KEY=your-seed-publishable-key
STACK_SEED_INTERNAL_PROJECT_SECRET_SERVER_KEY=your-seed-secret-key
STACK_SEED_INTERNAL_PROJECT_SUPER_SECRET_ADMIN_KEY=your-seed-admin-key
STACK_SEED_INTERNAL_PROJECT_USER_EMAIL=admin@example.com
STACK_SEED_INTERNAL_PROJECT_USER_PASSWORD=changeme
STACK_SEED_INTERNAL_PROJECT_USER_INTERNAL_ACCESS=true
STACK_SEED_INTERNAL_PROJECT_SIGN_UP_ENABLED=true
STACK_SEED_INTERNAL_PROJECT_ALLOW_LOCALHOST=true

# Email (optional, for production email sending)
STACK_EMAILABLE_API_KEY=
